<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are off (allowBackup=false); these rules say the same for device-to-device transfer on Android 12+ (audit, 12 Oct 2026):
     the quick-review seed and the wallet's auth token stay on the phone they were made on. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="undersigned_quick.xml" />
        <exclude domain="sharedpref" path="undersigned_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="undersigned_quick.xml" />
        <exclude domain="sharedpref" path="undersigned_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
