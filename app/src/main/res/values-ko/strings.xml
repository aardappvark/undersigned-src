    <string name="report_title">기록 신고</string>
    <string name="report_body">신고는 플래그와 다릅니다. 플래그는 서명되어 공개되며 합의를 통해 기록을 숨기지만, 신고는 원장을 벗어나 사람에게 전달되며 법이나 스토어 규정을 위반하는 콘텐츠에 사용됩니다.</string>
    <string name="report_why">사유</string>
    <string name="report_illegal">불법 콘텐츠</string>
